rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.enabled == true;
    }

    // 직원 권한 확인용 문서. 본인 문서만 읽기 허용.
    match /staff/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /brands/{brandId} {
      allow read, write: if isStaff();
    }

    match /fishing_rods/{rodId} {
      allow read, write: if isStaff();
    }

    match /equipment_categories/{categoryId} {
      allow read, write: if isStaff();
    }

    match /equipment_products/{productId} {
      allow read, write: if isStaff();
    }

    match /quote_records/{quoteId} {
      function validQuote() {
        let data = request.resource.data;
        return data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
            data.note is string && data.note.size() <= 4000 &&
            (!('customerName' in data) ||
                (data.customerName is string && data.customerName.size() <= 120)) &&
            data.mode in ['purchase', 'sale'] &&
            data.items is list && data.items.size() > 0 && data.items.size() <= 500 &&
            data.totalQuantity is int && data.totalQuantity > 0 &&
            data.totalPrice is number && data.totalPrice >= 0;
      }

      allow read, delete: if isStaff();
      allow create: if isStaff() && validQuote() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.revision == 0;
      allow update: if isStaff() && validQuote() &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.revision == resource.data.get('revision', 0) + 1 &&
          request.resource.data.updatedAt == request.time;
    }
  }
}
